# Software SaaS AI - Plesk / PostgreSQL 13 compatible template. No credentials included.
APP_NAME="Software SaaS AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<hostname>
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=<database>
DB_USERNAME=<database-user>
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Exact IPs/CIDRs of verified proxies only; never use *.
TRUSTED_PROXIES=
# Provider URL has no /v1 suffix. Configure credentials privately before enabling chat.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=
ASSISTANT_REASONING_EFFORT=none
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=
OPENROUTER_TTS_VOICE=
VITE_APP_NAME="${APP_NAME}"
