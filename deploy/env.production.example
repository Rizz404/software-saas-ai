# Cafe AI — production environment template.
# Copy to the server's shared .env (mode 0600, owned by the deploy user).
# Never commit real values. Fill every <...>.

APP_NAME="Cafe AI"
APP_ENV=production
APP_KEY=<php artisan key:generate --show>
APP_DEBUG=false
APP_URL=https://<hostname>
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# SQLite file on the shared volume, or point this at MySQL/PostgreSQL.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/cafe-ai/shared/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=log

# AI Barista provider (HTTPS required in production; base URL without /v1).
# Budgets live in config/assistant.php.
LOCAL_LLM_BASE_URL=https://<provider-host>
LOCAL_LLM_API_KEY=<secret>
LOCAL_LLM_MODEL=<model-alias>
ASSISTANT_REASONING_EFFORT=none
